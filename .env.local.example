NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# obrigatório para a assinatura própria (página pública /assinar opera por service role)
SUPABASE_SERVICE_ROLE_KEY=
RECEITA_API_URL=
RECEITA_API_TOKEN=
# ZapSign agora é OPCIONAL — a assinatura eletrônica é própria (lib/esign.ts)
ZAPSIGN_API_TOKEN=
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Brevo — envia o código (OTP) da assinatura AVANÇADA. Sem a chave, cai na SIMPLES.
BREVO_API_KEY=
BREVO_REMETENTE_EMAIL=no-reply@enquadria.com.br
BREVO_REMETENTE_NOME=Enquadria
# Digest mensal — segredo do agendador. O Vercel Cron envia automaticamente
# "Authorization: Bearer $CRON_SECRET". Sem esta variável, /api/digest recusa
# qualquer chamada. Teste sem enviar: /api/digest?segredo=SEU_SEGREDO&teste=1
CRON_SECRET=
# Sal do limitador da verificação pública. Serve para agrupar tentativas da
# mesma origem SEM guardar o IP (LGPD). Sem ele, usa o CRON_SECRET.
VERIFICACAO_SALT=
# Carimbo do tempo (Nível 3) — opcional. Sem URL, usa o carimbo do servidor.
# Aponte para uma ACT/RFC-3161 (contrato: POST {hash} -> {token, carimbo_em}).
CARIMBO_URL=
CARIMBO_TOKEN=

# ─────────────────────────── SERVIDOR DE E-MAIL PRÓPRIO (Postal) ──────────
# O caminho padrão de saída do transacional. Sem estas duas, lib/email cai na
# Brevo — e o log diz por onde saiu, em toda mensagem.
POSTAL_URL=https://postal.contadorx.com.br
POSTAL_API_KEY=
POSTAL_FROM=Enquadria <nao-responda@enquadria.com.br>

# Protege /api/dev/testar-email. SEM ELA a rota devolve 401 e não manda nada —
# é de propósito: rota de teste de e-mail aberta é máquina de spam de graça.
MAILER_TEST_SECRET=

# Assistente da central de ajuda. SEM esta chave ele não responde, mesmo
# marcado como ligado no painel — a pergunta vira chamado em vez de erro.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# ABERTURA E CLIQUE DOS E-MAILS
#
# O Postal e a Brevo avisam por webhook quando um e-mail é aberto, clicado ou
# bate. A rota /api/email/evento recebe os dois no mesmo formato.
#
# Este segredo vai na QUERY da URL cadastrada no provedor:
#   https://app.enquadria.com.br/api/email/evento?s=SEU_SEGREDO
#
# Sem ele no ambiente a rota RECUSA (503) — de propósito. Uma rota que grava no
# banco a partir de POST anônimo é como uma base de métricas vira lixo.
# Gere com: openssl rand -hex 24
EMAIL_WEBHOOK_SEGREDO=

# o endereço canônico do SITE (o que vai no canonical, sitemap e robots).
# Em preview da Vercel, aponte para o domínio de preview para não anunciar produção.
NEXT_PUBLIC_SITE_URL=https://enquadria.com.br
